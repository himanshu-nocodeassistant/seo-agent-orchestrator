# Runtime environment for Kanban API database selection
# Values: production | staging
# production uses sqlite:///./kanban.db
# staging uses sqlite:///./kanban.staging.db
APP_ENV=production

# Optional explicit database URL override (highest precedence)
# Example: sqlite:///./kanban.custom.db
# DATABASE_URL=sqlite:///./kanban.db

# Comment autopilot settings
# Enable background processing of user comments starting with "@agent"
COMMENT_AUTOPILOT_ENABLED=true

# Poll interval in seconds (default 15 minutes)
COMMENT_AUTOPILOT_INTERVAL_SECONDS=900

# Timeout for a single agent execution call in seconds
AGENT_EXECUTION_TIMEOUT_SECONDS=900

# Optional Webflow integration
# WEBFLOW_ACCESS_TOKEN=
# WEBFLOW_SITE_ID=
# WEBFLOW_COLLECTION_ID=

# Optional Google Docs integration
# GOOGLE_DOCS_CREDENTIALS_PATH=Google SA Credentials/your-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=Google SA Credentials/your-service-account.json

# Optional DataForSEO integration (batch extraction pipeline)
# Note: DATAFORSEO_PASSWORD is the API password from your DataForSEO dashboard,
# not your account login password.
# DATAFORSEO_LOGIN=your_login_email
# DATAFORSEO_PASSWORD=your_api_password

# Domain whose rankings/mentions the pipeline flags as "yours" in report output
# (e.g. serp_recover_from_ids.py --target-domain). Plain bare domain, no protocol.
# SEO_TARGET_DOMAIN=yoursite.com
